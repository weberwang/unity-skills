{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unity-skills:unity-game-build-player-character:player-character-skeletal-animation:2.0",
  "title": "P3-002 玩家角色骨骼动画规格",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "recordType", "projectId", "characterId", "animationId", "animationVersion",
    "sourceRevision", "projectStateVersion", "status", "durationSeconds", "sampleRate",
    "rigBinding", "deformationBudget", "motionQuality", "runtimeIntegration", "keyPoses",
    "timeScript", "visualEvents", "regression", "builder"
  ],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "recordType": {"const": "PLAYER_CHARACTER_SKELETAL_ANIMATION"},
    "projectId": {"const": "star-blogger"},
    "characterId": {"const": "P3-002"},
    "animationId": {"$ref": "#/$defs/id"},
    "animationVersion": {"type": "string", "minLength": 1},
    "sourceRevision": {"type": "string", "minLength": 1},
    "projectStateVersion": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "PLAYER_CHARACTER_ANIMATION_DRAFT",
        "PLAYER_CHARACTER_ANIMATION_POSE_CARDS_AWAITING_REVIEW",
        "PLAYER_CHARACTER_ANIMATION_POSE_CARDS_APPROVED",
        "PLAYER_CHARACTER_ANIMATION_TRANSITIONS_BUILT",
        "PLAYER_CHARACTER_ANIMATION_REGRESSION_REVIEWING",
        "PLAYER_CHARACTER_ANIMATION_APPROVED",
        "PLAYER_CHARACTER_ANIMATION_BLOCKED"
      ]
    },
    "blockedReason": {"type": "string", "minLength": 1},
    "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
    "sampleRate": {"type": "integer", "minimum": 12, "maximum": 120},
    "rigBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefab", "skeletalSystemVersion", "skeletalSystemEvidence", "rigVersion", "boneCount",
        "rootBone", "axisCalibrationEvidence", "effectorBones"
      ],
      "properties": {
        "prefab": {"$ref": "#/$defs/binding"},
        "skeletalSystemVersion": {"type": "string", "minLength": 1},
        "skeletalSystemEvidence": {"$ref": "#/$defs/binding"},
        "rigVersion": {"type": "string", "minLength": 1},
        "boneCount": {"const": 30},
        "rootBone": {"type": "string", "minLength": 1},
        "axisCalibrationEvidence": {"$ref": "#/$defs/binding"},
        "effectorBones": {
          "type": "object",
          "additionalProperties": false,
          "required": ["head", "leftHand", "rightHand", "leftFoot", "rightFoot"],
          "properties": {
            "head": {"type": "string", "minLength": 1},
            "leftHand": {"type": "string", "minLength": 1},
            "rightHand": {"type": "string", "minLength": 1},
            "leftFoot": {"type": "string", "minLength": 1},
            "rightFoot": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "deformationBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shoulderRotationMaxDegrees", "elbowFlexionDegrees", "pantsLegSpreadMaxUnits",
        "hairSwingMaxUnits", "handScaleAllowed", "footScaleAllowed", "rigidLayers", "meshRevisionTriggers"
      ],
      "properties": {
        "shoulderRotationMaxDegrees": {"type": "number", "minimum": 0, "maximum": 180},
        "elbowFlexionDegrees": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"type": "number", "minimum": 0, "maximum": 180},
            "maximum": {"type": "number", "minimum": 0, "maximum": 180}
          }
        },
        "pantsLegSpreadMaxUnits": {"type": "number", "minimum": 0},
        "hairSwingMaxUnits": {"type": "number", "minimum": 0},
        "handScaleAllowed": {"type": "boolean"},
        "footScaleAllowed": {"type": "boolean"},
        "rigidLayers": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "meshRevisionTriggers": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "motionQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priorityOrder", "style", "maxIkWeightDeltaPerFrame", "maxJointExtensionRatio",
        "timingContrast", "playbackReviewRates"
      ],
      "properties": {
        "priorityOrder": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"const": "KEY_POSE"},
            {"const": "TIMING"},
            {"const": "TRAJECTORY"},
            {"const": "SECONDARY_MOTION"}
          ],
          "items": false
        },
        "style": {
          "enum": ["SNAPPY_WEIGHTED", "SOFT_ELASTIC", "MECHANICAL", "REALISTIC"]
        },
        "maxIkWeightDeltaPerFrame": {
          "type": "number", "exclusiveMinimum": 0, "maximum": 1
        },
        "maxJointExtensionRatio": {
          "type": "number", "exclusiveMinimum": 0.5, "maximum": 1
        },
        "timingContrast": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preparationSegmentId", "burstSegmentId", "maxBurstToPreparationRatio"],
          "properties": {
            "preparationSegmentId": {"$ref": "#/$defs/id"},
            "burstSegmentId": {"$ref": "#/$defs/id"},
            "maxBurstToPreparationRatio": {
              "type": "number", "exclusiveMinimum": 0, "maximum": 1
            }
          }
        },
        "playbackReviewRates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{"const": 1.0}, {"const": 0.25}],
          "items": false
        }
      }
    },
    "runtimeIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionClass", "movementAuthority", "entryTransitionSeconds", "exitTransitionSeconds",
        "interruptPolicy", "phaseSync"
      ],
      "properties": {
        "actionClass": {"enum": ["LOCOMOTION", "ONE_SHOT", "LOOPING_EMOTE"]},
        "movementAuthority": {"enum": ["GAMEPLAY_RIGIDBODY_2D", "GAMEPLAY_TRANSFORM"]},
        "entryTransitionSeconds": {"type": "number", "minimum": 0, "maximum": 0.5},
        "exitTransitionSeconds": {"type": "number", "minimum": 0, "maximum": 0.5},
        "interruptPolicy": {
          "enum": ["IMMEDIATE", "AFTER_BURST", "AFTER_ACCENT", "AFTER_RECOVERY"]
        },
        "phaseSync": {
          "enum": ["NOT_APPLICABLE", "MATCH_CONTACT_PHASE", "MATCH_NORMALIZED_TIME"]
        }
      }
    },
    "keyPoses": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/keyPose"}
    },
    "timeScript": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/timeSegment"}
    },
    "visualEvents": {
      "type": "array",
      "items": {"$ref": "#/$defs/visualEvent"}
    },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cameraEvidence", "captures"],
      "properties": {
        "cameraEvidence": {"$ref": "#/$defs/binding"},
        "captures": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["poseId", "timeSeconds", "screenshot", "result"],
            "properties": {
              "poseId": {"$ref": "#/$defs/id"},
              "timeSeconds": {"type": "number", "minimum": 0},
              "screenshot": {"$ref": "#/$defs/binding"},
              "result": {"enum": ["PENDING", "PASS", "FAIL"]}
            }
          }
        }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builderId", "curveSource", "outputClipPath", "overwritePolicy", "rootMotion"],
      "properties": {
        "builderId": {"type": "string", "minLength": 1},
        "curveSource": {"const": "APPROVED_RESOLVED_POSES"},
        "outputClipPath": {"$ref": "#/$defs/animationClipPath"},
        "overwritePolicy": {"const": "CREATE_VERSIONED_CLIP"},
        "rootMotion": {"const": false}
      }
    },
    "buildResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clip", "curveReport", "generatedAtUtc", "builderVersion"],
      "properties": {
        "clip": {"$ref": "#/$defs/binding"},
        "curveReport": {"$ref": "#/$defs/binding"},
        "generatedAtUtc": {"type": "string", "format": "date-time"},
        "builderVersion": {"type": "string", "minLength": 1}
      }
    },
    "motionReview": {"$ref": "#/$defs/motionReview"},
    "poseCardsApproval": {"$ref": "#/$defs/approval"},
    "finalApproval": {"$ref": "#/$defs/approval"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PLAYER_CHARACTER_ANIMATION_BLOCKED"}}, "required": ["status"]},
      "then": {"required": ["blockedReason"]}
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "PLAYER_CHARACTER_ANIMATION_POSE_CARDS_APPROVED",
              "PLAYER_CHARACTER_ANIMATION_TRANSITIONS_BUILT",
              "PLAYER_CHARACTER_ANIMATION_REGRESSION_REVIEWING",
              "PLAYER_CHARACTER_ANIMATION_APPROVED"
            ]
          }
        },
        "required": ["status"]
      },
      "then": {"required": ["poseCardsApproval"]}
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "PLAYER_CHARACTER_ANIMATION_TRANSITIONS_BUILT",
              "PLAYER_CHARACTER_ANIMATION_REGRESSION_REVIEWING",
              "PLAYER_CHARACTER_ANIMATION_APPROVED"
            ]
          }
        },
        "required": ["status"]
      },
      "then": {"required": ["buildResult"]}
    },
    {
      "if": {"properties": {"status": {"const": "PLAYER_CHARACTER_ANIMATION_APPROVED"}}, "required": ["status"]},
      "then": {"required": ["finalApproval"]}
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "PLAYER_CHARACTER_ANIMATION_REGRESSION_REVIEWING",
              "PLAYER_CHARACTER_ANIMATION_APPROVED"
            ]
          }
        },
        "required": ["status"]
      },
      "then": {"required": ["motionReview"]}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,95}$"},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "animationClipPath": {
      "allOf": [
        {"$ref": "#/$defs/safePath"},
        {"pattern": "\\.[Aa][Nn][Ii][Mm]$"}
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      }
    },
    "worldTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "toleranceUnits"],
      "properties": {
        "position": {"$ref": "#/$defs/point"},
        "toleranceUnits": {"type": "number", "minimum": 0}
      }
    },
    "footContact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "maxSlipUnits"],
      "properties": {
        "state": {"enum": ["PLANTED", "RELEASED", "AIRBORNE"]},
        "anchor": {"$ref": "#/$defs/point"},
        "maxSlipUnits": {"type": "number", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "PLANTED"}}, "required": ["state"]},
          "then": {"required": ["anchor"]}
        }
      ]
    },
    "jointShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bendDirection", "minimumBendDegrees"],
      "properties": {
        "bendDirection": {
          "enum": ["SCREEN_LEFT", "SCREEN_RIGHT", "INWARD", "OUTWARD", "FORWARD", "BACKWARD"]
        },
        "minimumBendDegrees": {"type": "number", "minimum": 0, "maximum": 180}
      }
    },
    "visualState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "eyes", "mouth", "garmentHighlight", "flash", "notes"],
      "properties": {
        "expression": {"enum": ["NEUTRAL", "FOCUSED", "SMILE", "SPEAKING", "FROWN"]},
        "eyes": {"enum": ["OPEN", "BLINK"]},
        "mouth": {"enum": ["NEUTRAL", "SMILE", "OPEN", "FROWN"]},
        "garmentHighlight": {"type": "number", "minimum": 0, "maximum": 1},
        "flash": {"type": "number", "minimum": 0, "maximum": 1},
        "notes": {"type": "string"}
      }
    },
    "deformationAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "affectedRegions", "notes"],
      "properties": {
        "status": {"enum": ["WITHIN_BUDGET", "MESH_REVISION_REQUIRED", "BLOCKED"]},
        "affectedRegions": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "bodyMechanics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["centerOfMass", "support", "lineOfAction", "weightIntent"],
      "properties": {
        "centerOfMass": {"$ref": "#/$defs/point"},
        "support": {"enum": ["BOTH_FEET", "LEFT_FOOT", "RIGHT_FOOT", "AIRBORNE"]},
        "lineOfAction": {"type": "string", "minLength": 1},
        "weightIntent": {"type": "string", "minLength": 1}
      }
    },
    "keyPose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "timeSeconds", "intent", "silhouette", "bodyMechanics", "worldTargets",
        "contacts", "jointShapes", "visualState", "deformationAssessment", "status"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "timeSeconds": {"type": "number", "minimum": 0},
        "intent": {"enum": ["NEUTRAL", "ANTICIPATION", "EXPLOSION", "IMPACT", "CELEBRATION", "HOLD", "RECOVERY"]},
        "silhouette": {"type": "string", "minLength": 1},
        "bodyMechanics": {"$ref": "#/$defs/bodyMechanics"},
        "worldTargets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["space", "head", "leftHand", "rightHand", "leftFoot", "rightFoot"],
          "properties": {
            "space": {"const": "CHARACTER_ROOT_WORLD"},
            "head": {"$ref": "#/$defs/worldTarget"},
            "leftHand": {"$ref": "#/$defs/worldTarget"},
            "rightHand": {"$ref": "#/$defs/worldTarget"},
            "leftFoot": {"$ref": "#/$defs/worldTarget"},
            "rightFoot": {"$ref": "#/$defs/worldTarget"}
          }
        },
        "contacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["leftFoot", "rightFoot"],
          "properties": {
            "leftFoot": {"$ref": "#/$defs/footContact"},
            "rightFoot": {"$ref": "#/$defs/footContact"}
          }
        },
        "jointShapes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["leftElbow", "rightElbow", "leftKnee", "rightKnee"],
          "properties": {
            "leftElbow": {"$ref": "#/$defs/jointShape"},
            "rightElbow": {"$ref": "#/$defs/jointShape"},
            "leftKnee": {"$ref": "#/$defs/jointShape"},
            "rightKnee": {"$ref": "#/$defs/jointShape"}
          }
        },
        "visualState": {"$ref": "#/$defs/visualState"},
        "deformationAssessment": {"$ref": "#/$defs/deformationAssessment"},
        "acceptanceScreenshot": {"$ref": "#/$defs/binding"},
        "resolvedPoseEvidence": {"$ref": "#/$defs/binding"},
        "status": {"enum": ["DRAFT", "STATIC_POSE_PASS", "STATIC_POSE_FAIL"]}
      }
    },
    "timeSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "fromPoseId", "toPoseId", "startSeconds", "endSeconds", "phase", "transition",
        "holdSeconds", "trajectoryPlan", "leadChain", "followThroughDelaySeconds", "ikBlend"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "fromPoseId": {"$ref": "#/$defs/id"},
        "toPoseId": {"$ref": "#/$defs/id"},
        "startSeconds": {"type": "number", "minimum": 0},
        "endSeconds": {"type": "number", "exclusiveMinimum": 0},
        "phase": {
          "enum": ["PREPARATION", "BURST", "FOLLOW_THROUGH", "ACCENT_HOLD", "RECOVERY", "LOCOMOTION"]
        },
        "transition": {"enum": ["LINEAR", "EASE_IN", "EASE_OUT", "EASE_IN_OUT", "FAST", "HOLD"]},
        "holdSeconds": {"type": "number", "minimum": 0},
        "trajectoryPlan": {"$ref": "#/$defs/trajectoryPlan"},
        "leadChain": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "followThroughDelaySeconds": {"type": "number", "minimum": 0, "maximum": 0.5},
        "ikBlend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["leftFoot", "rightFoot"],
          "properties": {
            "leftFoot": {"$ref": "#/$defs/weightCurve"},
            "rightFoot": {"$ref": "#/$defs/weightCurve"}
          }
        }
      }
    },
    "trajectoryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "leftHand", "rightHand", "leftFoot", "rightFoot", "maxDeviationUnits"],
      "properties": {
        "head": {"$ref": "#/$defs/trajectoryMode"},
        "leftHand": {"$ref": "#/$defs/trajectoryMode"},
        "rightHand": {"$ref": "#/$defs/trajectoryMode"},
        "leftFoot": {"$ref": "#/$defs/trajectoryMode"},
        "rightFoot": {"$ref": "#/$defs/trajectoryMode"},
        "maxDeviationUnits": {"type": "number", "minimum": 0}
      }
    },
    "trajectoryMode": {"enum": ["ARC", "LINEAR", "LOCKED", "CUSTOM"]},
    "weightCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startWeight", "endWeight", "curve"],
      "properties": {
        "startWeight": {"type": "number", "minimum": 0, "maximum": 1},
        "endWeight": {"type": "number", "minimum": 0, "maximum": 1},
        "curve": {"enum": ["LINEAR", "EASE_IN", "EASE_OUT", "EASE_IN_OUT", "HOLD"]}
      }
    },
    "reviewResult": {"enum": ["PENDING", "PASS", "FAIL"]},
    "playbackReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playbackRate", "video", "result"],
      "properties": {
        "playbackRate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "video": {"$ref": "#/$defs/binding"},
        "result": {"$ref": "#/$defs/reviewResult"}
      }
    },
    "motionReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalSpeedPlayback", "slowMotionPlayback", "trajectoryEvidence", "segmentChecks"],
      "properties": {
        "normalSpeedPlayback": {
          "allOf": [
            {"$ref": "#/$defs/playbackReview"},
            {"properties": {"playbackRate": {"const": 1.0}}}
          ]
        },
        "slowMotionPlayback": {
          "allOf": [
            {"$ref": "#/$defs/playbackReview"},
            {"properties": {"playbackRate": {"const": 0.25}}}
          ]
        },
        "trajectoryEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["report", "result"],
          "properties": {
            "report": {"$ref": "#/$defs/binding"},
            "result": {"$ref": "#/$defs/reviewResult"}
          }
        },
        "segmentChecks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segmentId", "speedContinuity", "trajectory", "ikContinuity", "bodyMechanics", "tension"
            ],
            "properties": {
              "segmentId": {"$ref": "#/$defs/id"},
              "speedContinuity": {"$ref": "#/$defs/reviewResult"},
              "trajectory": {"$ref": "#/$defs/reviewResult"},
              "ikContinuity": {"$ref": "#/$defs/reviewResult"},
              "bodyMechanics": {"$ref": "#/$defs/reviewResult"},
              "tension": {"$ref": "#/$defs/reviewResult"}
            }
          }
        }
      }
    },
    "visualEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timeSeconds", "eventType", "target", "value", "durationSeconds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "timeSeconds": {"type": "number", "minimum": 0},
        "eventType": {"enum": ["EXPRESSION", "COLOR", "HIGHLIGHT", "FLASH", "TRAIL", "SECONDARY_MOTION"]},
        "target": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "boolean"]},
        "durationSeconds": {"type": "number", "minimum": 0}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectId", "subjectVersion", "approvedBy", "approvedAtUtc", "evidence"],
      "properties": {
        "subjectId": {"$ref": "#/$defs/id"},
        "subjectVersion": {"type": "string", "minLength": 1},
        "approvedBy": {"type": "string", "minLength": 1},
        "approvedAtUtc": {"type": "string", "format": "date-time"},
        "evidence": {"$ref": "#/$defs/binding"}
      }
    }
  }
}
