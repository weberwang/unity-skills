{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unity-skills:unity-game-build-player-character:player-character-2d-skeletal-system:1.0",
  "title": "P3-002 Unity 2D 骨骼系统规格",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "recordType", "projectId", "characterId", "systemVersion",
    "sourceRevision", "projectStateVersion", "status", "pipeline", "rig", "rendering",
    "skinning", "ik", "animationControl", "facing", "gameplaySync", "physics",
    "attachments", "performance", "evidence"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "recordType": {"const": "PLAYER_CHARACTER_2D_SKELETAL_SYSTEM"},
    "projectId": {"const": "star-blogger"},
    "characterId": {"const": "P3-002"},
    "systemVersion": {"type": "string", "minLength": 1},
    "sourceRevision": {"type": "string", "minLength": 1},
    "projectStateVersion": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "PLAYER_CHARACTER_SKELETAL_SYSTEM_DRAFT",
        "PLAYER_CHARACTER_SKELETAL_SYSTEM_AUDITED",
        "PLAYER_CHARACTER_SKELETAL_SYSTEM_APPROVED",
        "PLAYER_CHARACTER_SKELETAL_SYSTEM_BLOCKED"
      ]
    },
    "blockedReason": {"type": "string", "minLength": 1},
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoringMode", "deformationMode", "sourceFormat", "runtimeController",
        "selectionReason", "rejectedRoutes"
      ],
      "properties": {
        "authoringMode": {"const": "UNITY_2D_ANIMATION"},
        "deformationMode": {"const": "HYBRID_SPRITE_SKIN"},
        "sourceFormat": {"const": "INDEPENDENT_PNG"},
        "runtimeController": {"const": "UNITY_ANIMATOR"},
        "selectionReason": {"type": "string", "minLength": 1},
        "rejectedRoutes": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "rig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefab", "rigVersion", "boneCount", "rootBone", "visualRoot", "facingRoot",
        "referencePose", "hierarchyEvidence", "pivotEvidence", "attachmentBones"
      ],
      "properties": {
        "prefab": {"$ref": "#/$defs/binding"},
        "rigVersion": {"type": "string", "minLength": 1},
        "boneCount": {"const": 30},
        "rootBone": {"type": "string", "minLength": 1},
        "visualRoot": {"type": "string", "minLength": 1},
        "facingRoot": {"type": "string", "minLength": 1},
        "referencePose": {"const": "A_POSE"},
        "hierarchyEvidence": {"$ref": "#/$defs/binding"},
        "pivotEvidence": {"$ref": "#/$defs/binding"},
        "attachmentBones": {
          "type": "array", "minItems": 3,
          "items": {"$ref": "#/$defs/attachmentBone"}
        }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sortingGroupPath", "sortingBands", "dynamicRules", "evidence"],
      "properties": {
        "sortingGroupPath": {"type": "string", "minLength": 1},
        "sortingBands": {
          "type": "array", "minItems": 6,
          "items": {"$ref": "#/$defs/sortingBand"}
        },
        "dynamicRules": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/dynamicRule"}
        },
        "evidence": {"$ref": "#/$defs/binding"}
      }
    },
    "skinning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "maxVerticesPerLayer", "maxVerticesPerCharacter",
        "maxBoneInfluencesPerVertex", "hotspotRegions", "rigidLayers",
        "weightEvidence", "extremePoseEvidence"
      ],
      "properties": {
        "mode": {"const": "SPRITE_SKIN"},
        "maxVerticesPerLayer": {"type": "integer", "minimum": 4, "maximum": 4096},
        "maxVerticesPerCharacter": {"type": "integer", "minimum": 64, "maximum": 20000},
        "maxBoneInfluencesPerVertex": {"type": "integer", "minimum": 1, "maximum": 4},
        "hotspotRegions": {
          "type": "array", "minItems": 4, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rigidLayers": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "weightEvidence": {"$ref": "#/$defs/binding"},
        "extremePoseEvidence": {"$ref": "#/$defs/binding"}
      }
    },
    "ik": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solveOrder", "chains", "footGrounding", "twoHandConstraint", "evidence"],
      "properties": {
        "solveOrder": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [
            {"const": "BASE_CLIP"},
            {"const": "RUNTIME_IK"},
            {"const": "SECONDARY_MOTION"}
          ],
          "items": false
        },
        "chains": {
          "type": "array", "minItems": 3, "maxItems": 8,
          "items": {"$ref": "#/$defs/ikChain"}
        },
        "footGrounding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled", "groundLayers", "maxSlopeDegrees", "probeDistanceUnits",
            "blendSeconds", "outOfReachPolicy"
          ],
          "properties": {
            "enabled": {"const": true},
            "groundLayers": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "maxSlopeDegrees": {"type": "number", "minimum": 0, "maximum": 60},
            "probeDistanceUnits": {"type": "number", "exclusiveMinimum": 0},
            "blendSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
            "outOfReachPolicy": {"enum": ["CLAMP_TARGET", "REDUCE_WEIGHT", "MOVE_BODY"]}
          }
        },
        "twoHandConstraint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "primaryHand", "secondaryHand", "conflictPolicy"],
          "properties": {
            "enabled": {"type": "boolean"},
            "primaryHand": {"enum": ["LEFT", "RIGHT"]},
            "secondaryHand": {"enum": ["LEFT", "RIGHT"]},
            "conflictPolicy": {"const": "PRIMARY_HAND_DRIVES_SECONDARY_TARGET"}
          }
        },
        "evidence": {"$ref": "#/$defs/binding"}
      }
    },
    "animationControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller", "movementAuthority", "applyRootMotion", "layers", "locomotion",
        "transitionProfiles", "maxParameterDampingSeconds"
      ],
      "properties": {
        "controller": {"$ref": "#/$defs/binding"},
        "movementAuthority": {"enum": ["GAMEPLAY_RIGIDBODY_2D", "GAMEPLAY_TRANSFORM"]},
        "applyRootMotion": {"const": false},
        "layers": {
          "type": "array", "minItems": 2,
          "items": {"$ref": "#/$defs/animationLayer"}
        },
        "locomotion": {"$ref": "#/$defs/locomotion"},
        "transitionProfiles": {
          "type": "array", "minItems": 3,
          "items": {"$ref": "#/$defs/transitionProfile"}
        },
        "maxParameterDampingSeconds": {"type": "number", "minimum": 0, "maximum": 0.25}
      }
    },
    "facing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy", "facingNode", "physicsRootUnscaled", "ikMirrorPolicy",
        "asymmetricSpritePolicy", "evidence"
      ],
      "properties": {
        "strategy": {"const": "NEGATIVE_X_ON_VISUAL_ROOT"},
        "facingNode": {"type": "string", "minLength": 1},
        "physicsRootUnscaled": {"const": true},
        "ikMirrorPolicy": {"const": "REBIND_TARGETS_AND_BEND_DIRECTIONS"},
        "asymmetricSpritePolicy": {"const": "DEDICATED_VARIANT"},
        "evidence": {"$ref": "#/$defs/binding"}
      }
    },
    "gameplaySync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criticalEventAuthority", "animationEventRole", "criticalEvents",
        "presentationEvents", "evidence"
      ],
      "properties": {
        "criticalEventAuthority": {"const": "GAMEPLAY_ACTION_SPEC"},
        "animationEventRole": {"const": "PRESENTATION_ONLY"},
        "criticalEvents": {
          "type": "array", "minItems": 5, "uniqueItems": true,
          "items": {
            "enum": [
              "HITBOX_ON", "HITBOX_OFF", "PROJECTILE_SPAWN", "COMBO_WINDOW",
              "INVULNERABILITY_WINDOW", "ACTION_COMPLETE"
            ]
          }
        },
        "presentationEvents": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["FOOTSTEP", "EXPRESSION", "PARTICLE", "SOUND", "CAMERA_CUE"]}
        },
        "evidence": {"$ref": "#/$defs/binding"}
      }
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rigidbodyPath", "collisionRoot", "transformOwnership", "updateOrder",
        "boneFollowers", "ragdollPolicy", "evidence"
      ],
      "properties": {
        "rigidbodyPath": {"type": "string", "minLength": 1},
        "collisionRoot": {"type": "string", "minLength": 1},
        "transformOwnership": {"const": "RIGIDBODY_ROOT_BONES_VISUAL_ONLY"},
        "updateOrder": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [
            {"const": "PHYSICS"},
            {"const": "ANIMATION"},
            {"const": "LATE_CONSTRAINTS"}
          ],
          "items": false
        },
        "boneFollowers": {
          "type": "array", "minItems": 2,
          "items": {"$ref": "#/$defs/boneFollower"}
        },
        "ragdollPolicy": {"enum": ["DISABLED", "SEPARATE_MODE_WITH_EXPLICIT_HANDOFF"]},
        "evidence": {"$ref": "#/$defs/binding"}
      }
    },
    "attachments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skeletonReuse", "referencePose", "slots", "coverageEvidence"],
      "properties": {
        "skeletonReuse": {"const": "REQUIRED"},
        "referencePose": {"const": "A_POSE"},
        "slots": {
          "type": "array", "minItems": 3,
          "items": {"$ref": "#/$defs/attachmentSlot"}
        },
        "coverageEvidence": {"$ref": "#/$defs/binding"}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetPlatform", "maxVisibleCharacters", "maxBonesPerCharacter",
        "maxSkinnedVerticesPerCharacter", "maxActiveConstraintsPerCharacter",
        "maxBoneFollowersPerCharacter", "offscreenUpdatePolicy", "lodPolicy", "profilerEvidence"
      ],
      "properties": {
        "targetPlatform": {"enum": ["MOBILE", "DESKTOP", "CONSOLE"]},
        "maxVisibleCharacters": {"type": "integer", "minimum": 1},
        "maxBonesPerCharacter": {"const": 30},
        "maxSkinnedVerticesPerCharacter": {"type": "integer", "minimum": 64, "maximum": 20000},
        "maxActiveConstraintsPerCharacter": {"type": "integer", "minimum": 0, "maximum": 32},
        "maxBoneFollowersPerCharacter": {"type": "integer", "minimum": 0, "maximum": 32},
        "offscreenUpdatePolicy": {"enum": ["PAUSE_SKINNING_AND_IK", "REDUCE_UPDATE_RATE"]},
        "lodPolicy": {"enum": ["FULL_NEAR_SIMPLIFIED_FAR", "FULL_ONLY"]},
        "profilerEvidence": {"$ref": "#/$defs/binding"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referencePoseCapture", "hierarchyReport", "playModeReport",
        "facingCapture", "attachmentCapture", "performanceReport"
      ],
      "properties": {
        "referencePoseCapture": {"$ref": "#/$defs/binding"},
        "hierarchyReport": {"$ref": "#/$defs/binding"},
        "playModeReport": {"$ref": "#/$defs/binding"},
        "facingCapture": {"$ref": "#/$defs/binding"},
        "attachmentCapture": {"$ref": "#/$defs/binding"},
        "performanceReport": {"$ref": "#/$defs/binding"}
      }
    },
    "approval": {"$ref": "#/$defs/approval"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "PLAYER_CHARACTER_SKELETAL_SYSTEM_BLOCKED"}},
        "required": ["status"]
      },
      "then": {"required": ["blockedReason"]}
    },
    {
      "if": {
        "properties": {"status": {"const": "PLAYER_CHARACTER_SKELETAL_SYSTEM_APPROVED"}},
        "required": ["status"]
      },
      "then": {"required": ["approval"]}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,95}$"},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "attachmentBone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bone", "purpose"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "bone": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "sortingBand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "responsibilities"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "order": {"type": "integer"},
        "responsibilities": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "dynamicRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition", "result"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "condition": {"type": "string", "minLength": 1},
        "result": {"type": "string", "minLength": 1}
      }
    },
    "ikChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "purpose", "endEffector", "chainLength", "bendDirection",
        "blendSeconds", "outOfReachPolicy", "enabled"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "purpose": {"enum": ["FOOT_GROUNDING", "HAND_TARGET", "HEAD_LOOK", "TWO_HAND_GRIP"]},
        "endEffector": {"type": "string", "minLength": 1},
        "chainLength": {"type": "integer", "minimum": 1, "maximum": 4},
        "bendDirection": {
          "enum": ["SCREEN_LEFT", "SCREEN_RIGHT", "INWARD", "OUTWARD", "FORWARD", "BACKWARD"]
        },
        "blendSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
        "outOfReachPolicy": {"enum": ["CLAMP_TARGET", "REDUCE_WEIGHT", "MOVE_BODY"]},
        "enabled": {"type": "boolean"}
      }
    },
    "animationLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "mask", "weight"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["BASE", "UPPER_BODY", "ADDITIVE_SECONDARY"]},
        "mask": {"type": "string", "minLength": 1},
        "weight": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "locomotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "blendMode", "strideLengthUnits", "cycleSeconds",
        "expectedSpeedUnitsPerSecond", "maxFootSlipUnits", "phaseSync"
      ],
      "properties": {
        "enabled": {"const": true},
        "blendMode": {"enum": ["SPEED_1D", "DIRECTIONAL_2D"]},
        "strideLengthUnits": {"type": "number", "exclusiveMinimum": 0},
        "cycleSeconds": {"type": "number", "exclusiveMinimum": 0},
        "expectedSpeedUnitsPerSecond": {"type": "number", "exclusiveMinimum": 0},
        "maxFootSlipUnits": {"type": "number", "minimum": 0},
        "phaseSync": {"const": "CONTACT_PHASE"}
      }
    },
    "transitionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "durationSeconds", "interruptPolicy"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "class": {"enum": ["LOCOMOTION", "ATTACK", "HIT_REACTION", "JUMP_LAND", "EMOTE"]},
        "durationSeconds": {"type": "number", "minimum": 0, "maximum": 0.5},
        "interruptPolicy": {"enum": ["IMMEDIATE", "WINDOWED", "AFTER_ACCENT", "AFTER_RECOVERY"]}
      }
    },
    "boneFollower": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bone", "purpose", "writeMode"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "bone": {"type": "string", "minLength": 1},
        "purpose": {"enum": ["HITBOX", "HURTBOX", "INTERACTION_POINT", "VFX_ORIGIN"]},
        "writeMode": {"const": "READ_BONE_WRITE_FOLLOWER_ONLY"}
      }
    },
    "attachmentSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bone", "sortingPolicy", "localPoseEvidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "bone": {"type": "string", "minLength": 1},
        "sortingPolicy": {"enum": ["FIXED_BAND", "DYNAMIC_FRONT_BACK"]},
        "localPoseEvidence": {"$ref": "#/$defs/binding"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectVersion", "approvedBy", "approvedAtUtc", "evidence"],
      "properties": {
        "subjectVersion": {"type": "string", "minLength": 1},
        "approvedBy": {"type": "string", "minLength": 1},
        "approvedAtUtc": {"type": "string", "format": "date-time"},
        "evidence": {"$ref": "#/$defs/binding"}
      }
    }
  }
}
