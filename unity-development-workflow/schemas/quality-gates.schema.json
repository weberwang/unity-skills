{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/unity-workflow/schemas/quality-gates.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "sourceRevision", "projectStateVersion", "activeDecomposition", "activeProjectProfile", "gates"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "projectId": {"$ref": "common.schema.json#/$defs/taskId"},
    "sourceRevision": {"type": "string", "minLength": 1},
    "projectStateVersion": {"type": "string", "minLength": 1},
    "activeDecomposition": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/evidence"},
        {
          "required": ["subjectId", "subjectVersion", "sourceRevision", "projectStateVersion"],
          "properties": {"type": {"const": "decomposition-plan"}}
        }
      ]
    },
    "activeProjectProfile": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/evidence"},
        {
          "required": ["subjectId", "subjectVersion", "sourceRevision", "projectStateVersion"],
          "properties": {"type": {"const": "project-profile"}}
        }
      ]
    },
    "gates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "requiredChecks", "checkResults", "evidence"],
        "properties": {
          "id": {"enum": ["G0", "G1", "G2", "G3"]},
          "status": {"enum": ["NOT_RUN", "WAITING_APPROVAL", "PASS", "FAIL", "BLOCKED", "REVIEW_REQUIRED"]},
          "requiredChecks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/taskId"}
          },
          "checkResults": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "status", "evidence"],
              "properties": {
                "id": {"$ref": "common.schema.json#/$defs/taskId"},
                "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
                "evidence": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidence"}},
                "failureReason": {"type": "string", "minLength": 1}
              },
              "allOf": [
                {
                  "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
                  "then": {"properties": {"evidence": {"minItems": 1}}}
                },
                {
                  "if": {"properties": {"status": {"enum": ["FAIL", "BLOCKED"]}}, "required": ["status"]},
                  "then": {"required": ["failureReason"]}
                }
              ]
            }
          },
          "evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/evidence"}}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
            "then": {
              "properties": {
                "checkResults": {"minItems": 1},
                "evidence": {"minItems": 1}
              }
            }
          }
        ]
      }
    }
  }
}
