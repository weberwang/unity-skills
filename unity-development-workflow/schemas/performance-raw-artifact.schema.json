{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/unity-workflow/schemas/performance-raw-artifact.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "version", "projectId", "sourceRevision",
    "projectStateVersion", "buildVersion", "developmentCompletionEvidence", "metric", "unit",
    "captureSource", "capturedAtUtc", "captureMetadata", "samples", "status"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"$ref": "common.schema.json#/$defs/taskId"},
    "version": {"type": "string", "minLength": 1},
    "projectId": {"$ref": "common.schema.json#/$defs/taskId"},
    "sourceRevision": {"type": "string", "minLength": 1},
    "projectStateVersion": {"type": "string", "minLength": 1},
    "buildVersion": {"type": "string", "minLength": 1},
    "developmentCompletionEvidence": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/evidence"},
        {
          "required": ["projectId", "subjectId", "subjectVersion", "sourceRevision", "projectStateVersion"],
          "properties": {"type": {"const": "quality-gates"}, "subjectId": {"const": "g2.development-complete"}}
        }
      ]
    },
    "metric": {
      "enum": [
        "minimumFps", "maximumCpuFrameTimeMs", "maximumGpuFrameTimeMs",
        "maximumMemoryMb", "maximumGcAllocKbPerFrame", "maximumDrawCalls",
        "maximumTextureMemoryMb", "maximumBuildSizeMb", "maximumLoadTimeSeconds"
      ]
    },
    "unit": {"enum": ["fps", "ms", "MB", "KB/frame", "count/frame", "s"]},
    "captureSource": {
      "enum": ["UNITY_PROFILER", "UNITY_BUILD_REPORT", "RUNTIME_STOPWATCH"]
    },
    "capturedAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:[Zz]|[+]00:00)$"
    },
    "captureMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform", "buildConfiguration", "unityVersion", "operatingSystem",
        "cpu", "gpu", "memoryMb", "sampleCount", "warmupSeconds",
        "durationSeconds", "captureTool", "captureToolVersion"
      ],
      "properties": {
        "platform": {"enum": ["WINDOWS", "ANDROID", "IOS", "IPADOS"]},
        "buildConfiguration": {"enum": ["DEVELOPMENT", "RELEASE"]},
        "unityVersion": {"type": "string", "minLength": 1},
        "operatingSystem": {"type": "string", "minLength": 1},
        "cpu": {"type": "string", "minLength": 1},
        "gpu": {"type": "string", "minLength": 1},
        "memoryMb": {"type": "integer", "minimum": 1},
        "sampleCount": {"type": "integer", "minimum": 1},
        "warmupSeconds": {"type": "number", "minimum": 0},
        "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
        "captureTool": {"type": "string", "minLength": 1},
        "captureToolVersion": {"type": "string", "minLength": 1}
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number"}
    },
    "status": {"const": "VERIFIED"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metric": {
            "enum": [
              "minimumFps", "maximumCpuFrameTimeMs", "maximumGpuFrameTimeMs",
              "maximumMemoryMb", "maximumGcAllocKbPerFrame", "maximumDrawCalls",
              "maximumTextureMemoryMb"
            ]
          }
        },
        "required": ["metric"]
      },
      "then": {"properties": {"captureSource": {"const": "UNITY_PROFILER"}}}
    },
    {
      "if": {
        "properties": {"metric": {"const": "maximumBuildSizeMb"}},
        "required": ["metric"]
      },
      "then": {"properties": {"captureSource": {"const": "UNITY_BUILD_REPORT"}}}
    },
    {
      "if": {
        "properties": {"metric": {"const": "maximumLoadTimeSeconds"}},
        "required": ["metric"]
      },
      "then": {"properties": {"captureSource": {"const": "RUNTIME_STOPWATCH"}}}
    }
  ]
}
