{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/unity-workflow/schemas/project-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "version", "sourceRevision", "projectStateVersion", "workflow", "unity", "delivery", "capabilities", "paths"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "projectId": {"$ref": "common.schema.json#/$defs/taskId"},
    "version": {"type": "string", "minLength": 1},
    "sourceRevision": {"type": "string", "minLength": 1},
    "projectStateVersion": {"type": "string", "minLength": 1},
    "candidateSnapshot": {"$ref": "common.schema.json#/$defs/candidateSnapshot"},
    "grillingEvidence": {"$ref": "common.schema.json#/$defs/grillingEvidence"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "gate", "qualityTargetsStatus", "sourceRevision", "projectStateVersion", "decomposition"],
      "properties": {
        "channel": {"enum": ["QUICK", "STANDARD", "RELEASE"]},
        "gate": {"enum": ["G0", "G1", "G2", "G3"]},
        "qualityTargetsStatus": {"enum": ["PROPOSED", "APPROVED"]},
        "sourceRevision": {"type": "string", "minLength": 1},
        "projectStateVersion": {"type": "string", "minLength": 1},
        "decomposition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "status"],
          "properties": {
            "id": {"$ref": "common.schema.json#/$defs/taskId"},
            "version": {"type": "string", "minLength": 1},
            "status": {"enum": ["DRAFT", "QUESTIONING", "AWAITING_USER", "APPROVED", "REJECTED", "BLOCKED"]}
          }
        }
      }
    },
    "unity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "renderPipeline"],
      "properties": {
        "version": {"const": "6"},
        "renderPipeline": {"const": "URP"}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformSelectionStatus", "primaryDevelopmentPlatform", "targets"],
      "properties": {
        "platformSelectionStatus": {"enum": ["PROPOSED", "AWAITING_USER", "APPROVED"]},
        "primaryDevelopmentPlatform": {"enum": ["WINDOWS", "ANDROID", "IOS", "IPADOS"]},
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/platformTarget"}
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login", "cloudSave", "purchases", "ads", "analytics", "crashReporting", "online"],
      "properties": {
        "login": {"type": "boolean"},
        "cloudSave": {"type": "boolean"},
        "purchases": {"type": "boolean"},
        "ads": {"type": "boolean"},
        "analytics": {"type": "boolean"},
        "crashReporting": {"type": "boolean"},
        "online": {"type": "boolean"}
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedSourceRoot", "runtimeArtRoot", "artifactRoot"],
      "properties": {
        "generatedSourceRoot": {"$ref": "common.schema.json#/$defs/projectRelativePath"},
        "runtimeArtRoot": {"const": "Assets/Art/Runtime"},
        "artifactRoot": {"$ref": "common.schema.json#/$defs/projectRelativePath"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"delivery": {"properties": {"platformSelectionStatus": {"const": "APPROVED"}}, "required": ["platformSelectionStatus"]}}, "required": ["delivery"]},
      "then": {"required": ["candidateSnapshot", "grillingEvidence"]}
    },
    {
      "if": {"properties": {"workflow": {"properties": {"qualityTargetsStatus": {"const": "APPROVED"}}, "required": ["qualityTargetsStatus"]}}, "required": ["workflow"]},
      "then": {"required": ["candidateSnapshot", "grillingEvidence"]}
    }
  ],
  "$defs": {
    "platformTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platformId", "adaptationFamily", "buildTarget", "distributionChannel",
        "deviceClasses", "orientations", "inputModes", "safeAreaRequired",
        "adaptiveLayoutRequired", "referenceResolutions", "quality"
      ],
      "properties": {
        "platformId": {"enum": ["WINDOWS", "ANDROID", "IOS", "IPADOS"]},
        "adaptationFamily": {"enum": ["WINDOWS", "MOBILE"]},
        "buildTarget": {"enum": ["WINDOWS_STANDALONE", "ANDROID", "IOS"]},
        "distributionChannel": {"type": "string", "minLength": 1},
        "deviceClasses": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["DESKTOP", "PHONE", "TABLET"]}
        },
        "orientations": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["LANDSCAPE", "PORTRAIT"]}
        },
        "inputModes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["KEYBOARD_MOUSE", "GAMEPAD", "TOUCH"]}
        },
        "safeAreaRequired": {"type": "boolean"},
        "adaptiveLayoutRequired": {"const": true},
        "windowModes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["WINDOWED", "FULLSCREEN_WINDOW"]}
        },
        "autorotation": {"type": "boolean"},
        "quality": {"$ref": "#/$defs/qualityBudget"},
        "referenceResolutions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height", "orientation"],
            "properties": {
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1},
              "orientation": {"enum": ["LANDSCAPE", "PORTRAIT"]}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"adaptationFamily": {"const": "WINDOWS"}}, "required": ["adaptationFamily"]},
          "then": {
            "required": ["windowModes"],
            "properties": {
              "platformId": {"const": "WINDOWS"},
              "buildTarget": {"const": "WINDOWS_STANDALONE"},
              "deviceClasses": {"const": ["DESKTOP"]},
              "safeAreaRequired": {"const": false}
            }
          }
        },
        {
          "if": {"properties": {"adaptationFamily": {"const": "MOBILE"}}, "required": ["adaptationFamily"]},
          "then": {
            "required": ["autorotation"],
            "properties": {
              "platformId": {"enum": ["ANDROID", "IOS", "IPADOS"]},
              "buildTarget": {"enum": ["ANDROID", "IOS"]},
              "deviceClasses": {"items": {"enum": ["PHONE", "TABLET"]}},
              "inputModes": {"contains": {"const": "TOUCH"}},
              "safeAreaRequired": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"platformId": {"const": "ANDROID"}}, "required": ["platformId"]},
          "then": {
            "properties": {
              "buildTarget": {"const": "ANDROID"},
              "deviceClasses": {"items": {"enum": ["PHONE", "TABLET"]}}
            }
          }
        },
        {
          "if": {"properties": {"platformId": {"const": "IOS"}}, "required": ["platformId"]},
          "then": {
            "properties": {
              "buildTarget": {"const": "IOS"},
              "deviceClasses": {"const": ["PHONE"]}
            }
          }
        },
        {
          "if": {"properties": {"platformId": {"const": "IPADOS"}}, "required": ["platformId"]},
          "then": {
            "properties": {
              "buildTarget": {"const": "IOS"},
              "deviceClasses": {"const": ["TABLET"]}
            }
          }
        }
      ]
    },
    "qualityBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumFps", "maximumCpuFrameTimeMs", "maximumGpuFrameTimeMs",
        "maximumMemoryMb", "maximumGcAllocKbPerFrame",
        "maximumDrawCalls", "maximumTextureMemoryMb", "maximumBuildSizeMb",
        "maximumLoadTimeSeconds"
      ],
      "properties": {
        "minimumFps": {"type": "number", "minimum": 0},
        "maximumCpuFrameTimeMs": {"type": "number", "minimum": 0},
        "maximumGpuFrameTimeMs": {"type": "number", "minimum": 0},
        "maximumMemoryMb": {"type": "number", "minimum": 0},
        "maximumGcAllocKbPerFrame": {"type": "number", "minimum": 0},
        "maximumDrawCalls": {"type": "number", "minimum": 0},
        "maximumTextureMemoryMb": {"type": "number", "minimum": 0},
        "maximumBuildSizeMb": {"type": "number", "minimum": 0},
        "maximumLoadTimeSeconds": {"type": "number", "minimum": 0}
      }
    }
  }
}
