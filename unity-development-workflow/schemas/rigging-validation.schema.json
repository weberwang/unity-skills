{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/unity-workflow/schemas/rigging-validation.schema.json",
  "title": "2D skeletal asset engineering validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "projectId", "sourceRevision", "prefabPath", "outputPath", "clips", "variants"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "taskId": {"type": "string", "minLength": 1},
    "projectId": {"type": "string", "minLength": 1},
    "sourceRevision": {"type": "string", "minLength": 1},
    "prefabPath": {"type": "string", "pattern": "^Assets/(?!/)(?!\\.\\.?(?:/|$))(?!.*(?:\\\\|//|(?:^|/)\\.\\.?(?:/|$))).+\\.prefab$"},
    "outputPath": {"type": "string", "pattern": "^Artifacts/(?!/)(?!\\.\\.?(?:/|$))(?!.*(?:\\\\|//|(?:^|/)\\.\\.?(?:/|$))).+\\.json$"},
    "clips": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "clipPath", "loop", "requiredEvents"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "clipPath": {"type": "string", "pattern": "^Assets/(?!/)(?!\\.\\.?(?:/|$))(?!.*(?:\\\\|//|(?:^|/)\\.\\.?(?:/|$))).+\\.anim$"},
          "loop": {"type": "boolean"},
          "requiredEvents": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "rendererPath", "spritePath", "spriteName"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "rendererPath": {"type": "string"},
          "spritePath": {"type": "string", "pattern": "^Assets/(?!/)(?!\\.\\.?(?:/|$))(?!.*(?:\\\\|//|(?:^|/)\\.\\.?(?:/|$))).+"},
          "spriteName": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
