{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/unity-workflow/schemas/split-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "projectId", "sceneId", "sourceRevision", "projectStateVersion", "sourceVersion", "visualBibleVersion",
    "sourceOrigin", "visualBibleEvidence", "prefabStructureEvidence", "highFidelityGenerationEvidence",
    "highFidelityReviewEvidence", "sourceImage", "sourceDimensions", "annotatedPreview", "coverageDeclaration",
    "splitQuestions", "items", "reviews", "status"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"$ref": "common.schema.json#/$defs/taskId"},
    "projectId": {"$ref": "common.schema.json#/$defs/taskId"},
    "sceneId": {"$ref": "common.schema.json#/$defs/taskId"},
    "sourceRevision": {"type": "string", "minLength": 1},
    "projectStateVersion": {"type": "string", "minLength": 1},
    "candidateSnapshot": {"$ref": "common.schema.json#/$defs/candidateSnapshot"},
    "grillingEvidence": {"$ref": "common.schema.json#/$defs/grillingEvidence"},
    "sourceVersion": {"type": "string", "minLength": 1},
    "visualBibleVersion": {"type": "string", "minLength": 1},
    "sourceOrigin": {"const": "REVIEW_FUNNEL_APPROVED"},
    "visualBibleEvidence": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/evidence"},
        {"properties": {"type": {"const": "visual-bible"}}, "required": ["type", "subjectId", "subjectVersion"]}
      ]
    },
    "prefabStructureEvidence": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/evidence"},
        {"properties": {"type": {"const": "prefab-structure"}}, "required": ["type", "subjectId", "subjectVersion"]}
      ]
    },
    "highFidelityGenerationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "sha256", "subjectId", "subjectVersion", "candidateId", "candidatePath", "candidateSha256", "candidateVisualVersion"],
      "properties": {
        "type": {"const": "image-generation"},
        "path": {"$ref": "common.schema.json#/$defs/projectRelativePath"},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "subjectId": {"$ref": "common.schema.json#/$defs/taskId"},
        "subjectVersion": {"type": "string", "minLength": 1},
        "candidateId": {"$ref": "common.schema.json#/$defs/taskId"},
        "candidatePath": {"$ref": "common.schema.json#/$defs/projectRelativePath"},
        "candidateSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "candidateVisualVersion": {"type": "string", "minLength": 1}
      }
    },
    "highFidelityReviewEvidence": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/evidence"},
        {"properties": {"type": {"const": "visual-review"}}, "required": ["type", "subjectId", "subjectVersion"]}
      ]
    },
    "sourceImage": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/evidence"},
        {"properties": {"type": {"const": "confirmed-high-fidelity-visual"}}, "required": ["type", "subjectId", "subjectVersion"]}
      ]
    },
    "sourceDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "annotatedPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "sha256", "sourcePath", "sourceSha256", "sourceVersion", "width", "height", "annotations"],
      "properties": {
        "type": {"const": "annotated-split-preview"},
        "path": {"$ref": "common.schema.json#/$defs/projectRelativePath"},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "sourcePath": {"$ref": "common.schema.json#/$defs/projectRelativePath"},
        "sourceSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "sourceVersion": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "annotations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/splitPlanAnnotation"}}
      }
    },
    "coverageDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allRequiredVisualElementsMapped", "declaredItemCount", "excludedElements"],
      "properties": {
        "allRequiredVisualElementsMapped": {"type": "boolean"},
        "declaredItemCount": {"type": "integer", "minimum": 1},
        "excludedElements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "reason"],
            "properties": {
              "description": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "splitQuestions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "answer", "decisionImpact"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/taskId"},
          "question": {"type": "string", "minLength": 1},
          "answer": {"type": "string", "minLength": 1},
          "decisionImpact": {"type": "string", "minLength": 1}
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": ["id", "resourceId", "itemVersion", "itemSpecSha256", "elementIndex", "assetType", "purpose", "generationBrief", "splitRationale", "targetPrefabNodeIds", "targetPath", "stateVariants", "bounds", "delivery", "action", "parentElementId", "semanticGrouping", "visualRouteAnalysis", "assemblyAnalysis", "layoutBinding"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/taskId"},
          "resourceId": {"$ref": "common.schema.json#/$defs/taskId"},
          "itemVersion": {"type": "string", "minLength": 1},
          "itemSpecSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "elementIndex": {"type": "integer", "minimum": 1},
          "assetType": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "generationBrief": {"type": "string", "minLength": 1},
          "splitRationale": {"type": "string", "minLength": 1},
          "targetPrefabNodeIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/taskId"}},
          "targetPath": {"$ref": "common.schema.json#/$defs/projectRelativePath"},
          "stateVariants": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "description"],
              "properties": {"id": {"$ref": "common.schema.json#/$defs/taskId"}, "description": {"type": "string", "minLength": 1}}
            }
          },
          "bounds": {
            "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
            "properties": {"x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
          },
          "targetSize": {
            "type": "object", "additionalProperties": false, "required": ["width", "height"],
            "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
          },
          "alphaRequired": {"type": "boolean"},
          "pivot": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}}},
          "pixelsPerUnit": {"type": "number", "exclusiveMinimum": 0},
          "border": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
          "delivery": {"enum": ["SINGLE_SPRITE", "SPRITE_SHEET", "ATLAS", "UI_TEXTURE", "NOT_APPLICABLE"]},
          "action": {"$ref": "common.schema.json#/$defs/productionRoute"},
          "existingAssetId": {"$ref": "common.schema.json#/$defs/taskId"},
          "reuseReason": {"type": "string", "minLength": 1},
          "reuseResourcePlan": {"$ref": "reuse-resource-plan.schema.json#/$defs/reuseResourcePlan"},
          "notes": {"type": "string"},
          "parentElementId": {"type": "string", "minLength": 1},
          "semanticGrouping": {"$ref": "common.schema.json#/$defs/semanticGrouping"},
          "visualRouteAnalysis": {"$ref": "common.schema.json#/$defs/visualRouteAnalysis"},
          "assemblyAnalysis": {"$ref": "common.schema.json#/$defs/assemblyAnalysis"},
          "layoutBinding": {"$ref": "common.schema.json#/$defs/layoutBinding"}
        },
        "allOf": [
          {
            "if": {"properties": {"assemblyAnalysis": {"properties": {"layoutSystem": {"enum": ["RECT_TRANSFORM", "UI_TOOLKIT", "CANVAS"]}}, "required": ["layoutSystem"]}}, "required": ["assemblyAnalysis"]},
            "then": {"properties": {"layoutBinding": {"required": ["uiLayout"]}}}
          },
          {
            "if": {"properties": {"delivery": {"const": "NOT_APPLICABLE"}}, "required": ["delivery"]},
            "then": {"not": {"anyOf": [{"required": ["targetSize"]}, {"required": ["alphaRequired"]}, {"required": ["pivot"]}, {"required": ["pixelsPerUnit"]}, {"required": ["border"]}]}},
            "else": {"required": ["targetSize", "alphaRequired", "pivot", "pixelsPerUnit"]}
          },
          {
            "if": {"properties": {"action": {"enum": ["MODEL_3D", "MATERIAL", "VFX", "CODE", "PROGRAMMATIC"]}}, "required": ["action"]},
            "then": {"properties": {"delivery": {"const": "NOT_APPLICABLE"}}}
          },
          {
            "if": {"properties": {"action": {"enum": ["GENERATE", "REDRAW"]}}, "required": ["action"]},
            "then": {"properties": {"delivery": {"enum": ["SINGLE_SPRITE", "SPRITE_SHEET", "ATLAS", "UI_TEXTURE"]}}}
          },
          {
            "if": {"properties": {"action": {"const": "REUSE"}}, "required": ["action"]},
            "then": {"required": ["existingAssetId", "reuseReason", "reuseResourcePlan"]},
            "else": {"not": {"required": ["reuseResourcePlan"]}}
          },
          {
            "if": {"properties": {"action": {"const": "BLOCKED"}}, "required": ["action"]},
            "then": {"properties": {"notes": {"type": "string", "minLength": 1}}, "required": ["notes"]}
          }
        ]
      }
    },
    "reviews": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/approval"}},
    "userApproval": {"$ref": "common.schema.json#/$defs/splitPlanApproval"},
    "status": {"enum": ["DRAFT", "REVIEWING", "APPROVED", "CHANGES_REQUIRED", "BLOCKED"]},
    "blockedReason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "APPROVED"}}, "required": ["status"]},
      "then": {
        "required": ["candidateSnapshot", "grillingEvidence", "userApproval"],
        "properties": {
          "coverageDeclaration": {"properties": {"allRequiredVisualElementsMapped": {"const": true}}},
          "userApproval": {
            "properties": {"approvalType": {"const": "ASSET_MAP"}, "authority": {"const": "USER"}},
            "required": ["approvalType", "authority"]
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]},
      "then": {"required": ["blockedReason"]}
    }
  ]
}
