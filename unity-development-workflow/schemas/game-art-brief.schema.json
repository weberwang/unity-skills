{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/unity-workflow/schemas/game-art-brief.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "theme",
    "audience",
    "coreLoop",
    "experienceGoals",
    "viewingContext",
    "visualHierarchy",
    "intensityBudget"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts",
        "assumptions"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coreLoop": {
      "type": "string",
      "minLength": 1
    },
    "experienceGoals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "viewingContext": {
      "type": "string",
      "minLength": 1
    },
    "visualHierarchy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "intensityBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normal",
        "operation",
        "peak",
        "measurementMethod"
      ],
      "properties": {
        "normal": {
          "$ref": "#/$defs/intensityLevel"
        },
        "operation": {
          "$ref": "#/$defs/intensityLevel"
        },
        "peak": {
          "$ref": "#/$defs/intensityLevel"
        },
        "measurementMethod": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "说明各层级预算采用的测量方法、观察条件和记录方式。"
        }
      }
    }
  },
  "$defs": {
    "intensityLevel": {
      "type": "object",
      "additionalProperties": false,
      "description": "normal、operation、peak 各自使用的严格刺激预算结构。",
      "required": [
        "brightnessContrast",
        "screenCoverage",
        "duration",
        "triggerFrequency",
        "maxConcurrent",
        "recovery",
        "blendPolicy"
      ],
      "properties": {
        "brightnessContrast": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "说明该层级的亮度变化与对比度边界。"
        },
        "screenCoverage": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "说明刺激占用的屏幕区域及覆盖限制。"
        },
        "duration": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "说明单次刺激的持续时长或结束条件。"
        },
        "triggerFrequency": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "说明触发频率、去重或重复策略。"
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 0,
          "description": "该层级允许同时活动的刺激数量上限。"
        },
        "recovery": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "说明刺激结束、打断或暂停后的恢复方式。"
        },
        "blendPolicy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "说明并发刺激的混合、合并、抑制或优先级策略。"
        }
      }
    }
  }
}
