{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/unity-workflow/schemas/module-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "sourceRevision", "projectStateVersion", "decompositionPlan", "status", "modules"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "projectId": {"$ref": "common.schema.json#/$defs/taskId"},
    "sourceRevision": {"type": "string", "minLength": 1},
    "projectStateVersion": {"type": "string", "minLength": 1},
    "decompositionPlan": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/evidence"},
        {
          "required": ["subjectId", "subjectVersion", "sourceRevision", "projectStateVersion"],
          "properties": {"type": {"const": "decomposition-plan"}}
        }
      ]
    },
    "status": {"enum": ["DRAFT", "APPROVED"]},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "responsibility", "ownerRole", "owns", "dependsOn", "publicInterfaces", "sceneConsumers"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.]{0,95}$"},
          "category": {"enum": ["Foundation", "Shared", "Gameplay", "Presentation", "Content", "QA", "Delivery"]},
          "responsibility": {"type": "string", "minLength": 1},
          "ownerRole": {"type": "string", "minLength": 1},
          "owns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/projectRelativePath"}
          },
          "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "publicInterfaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "sceneConsumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/taskId"}}
        },
        "allOf": [
          {
            "if": {"properties": {"category": {"const": "Shared"}}, "required": ["category"]},
            "then": {"properties": {"sceneConsumers": {"minItems": 2}}}
          }
        ]
      }
    }
  }
}
