{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/unity-workflow/schemas/visual-bible.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "version", "status", "artDirection", "palette", "lighting", "materials", "camera", "uiLanguage", "avoid", "reviews"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "projectId": {"$ref": "common.schema.json#/$defs/taskId"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "REVIEWING", "APPROVED", "REJECTED"]},
    "artDirection": {"type": "string", "minLength": 1},
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "accent", "background"],
      "properties": {
        "primary": {"$ref": "#/$defs/color"},
        "secondary": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"},
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "lighting": {"type": "string", "minLength": 1},
    "materials": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "camera": {"type": "string", "minLength": 1},
    "uiLanguage": {"type": "string", "minLength": 1},
    "avoid": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reviews": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/approval"}},
    "approval": {"$ref": "common.schema.json#/$defs/approval"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "APPROVED"}}, "required": ["status"]},
      "then": {
        "required": ["approval"],
        "properties": {
          "approval": {
            "allOf": [
              {"$ref": "common.schema.json#/$defs/approval"},
              {"properties": {"approvalType": {"const": "VISUAL_BASELINE"}, "authority": {"const": "USER"}}}
            ]
          },
          "reviews": {
            "minItems": 3,
            "allOf": [
              {"contains": {"properties": {"approvalType": {"const": "VISUAL_BASELINE"}, "authority": {"const": "INDEPENDENT_REVIEWER"}, "reviewDiscipline": {"const": "VISUAL_CONSISTENCY"}}, "required": ["approvalType", "authority", "reviewDiscipline"]}},
              {"contains": {"properties": {"approvalType": {"const": "VISUAL_BASELINE"}, "authority": {"const": "INDEPENDENT_REVIEWER"}, "reviewDiscipline": {"const": "UNITY_FEASIBILITY"}}, "required": ["approvalType", "authority", "reviewDiscipline"]}},
              {"contains": {"properties": {"approvalType": {"const": "VISUAL_BASELINE"}, "authority": {"const": "INDEPENDENT_REVIEWER"}, "reviewDiscipline": {"const": "UX_READABILITY"}}, "required": ["approvalType", "authority", "reviewDiscipline"]}}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
  }
}
