{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/unity-workflow/schemas/visual-bible.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "projectId", "version", "status", "designPillars", "artDirection",
    "worldLanguage", "assetLanguage", "palette", "lighting", "materials", "camera",
    "uiLanguage", "typography", "iconography", "motionLanguage", "readabilityRules",
    "avoid", "referencePolicy", "assetRegeneration", "directionCandidates", "reviews"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "projectId": {"$ref": "common.schema.json#/$defs/taskId"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "REVIEWING", "APPROVED", "REJECTED"]},
    "designPillars": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "artDirection": {"type": "string", "minLength": 1},
    "worldLanguage": {"type": "string", "minLength": 1},
    "assetLanguage": {"type": "string", "minLength": 1},
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "accent", "background"],
      "properties": {
        "primary": {"$ref": "#/$defs/color"},
        "secondary": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"},
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "lighting": {"type": "string", "minLength": 1},
    "materials": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "camera": {"type": "string", "minLength": 1},
    "uiLanguage": {"type": "string", "minLength": 1},
    "typography": {"type": "string", "minLength": 1},
    "iconography": {"type": "string", "minLength": 1},
    "motionLanguage": {"type": "string", "minLength": 1},
    "readabilityRules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "avoid": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "referencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["styleAuthority", "screenshotAllowedUses", "screenshotStyleTransfer", "screenshotPixelReuse"],
      "properties": {
        "styleAuthority": {"const": "APPROVED_VISUAL_BIBLE"},
        "screenshotAllowedUses": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": {"enum": ["CONTENT", "COMPOSITION", "INFORMATION_HIERARCHY"]}
        },
        "screenshotStyleTransfer": {"const": "FORBIDDEN"},
        "screenshotPixelReuse": {"const": "FORBIDDEN"}
      }
    },
    "assetRegeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "regenerateBeforeSplit", "splitOnlyAfterReview"],
      "properties": {
        "mode": {"const": "REGENERATE_FROM_VISUAL_BIBLE"},
        "regenerateBeforeSplit": {"const": true},
        "splitOnlyAfterReview": {"const": true}
      }
    },
    "directionCandidates": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/evidence"}},
    "selectedDirection": {"$ref": "common.schema.json#/$defs/evidence"},
    "finalVisualReview": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/evidence"},
        {"properties": {"type": {"const": "visual-review"}}, "required": ["type", "subjectId", "subjectVersion"]}
      ]
    },
    "reviews": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/approval"}},
    "approval": {"$ref": "common.schema.json#/$defs/approval"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "APPROVED"}}, "required": ["status"]},
      "then": {
        "required": ["selectedDirection", "finalVisualReview", "approval"],
        "properties": {
          "directionCandidates": {"minItems": 2},
          "approval": {
            "allOf": [
              {"$ref": "common.schema.json#/$defs/approval"},
              {"properties": {"approvalType": {"const": "VISUAL_BASELINE"}, "authority": {"const": "USER"}}}
            ]
          },
          "reviews": {
            "minItems": 3,
            "allOf": [
              {"contains": {"properties": {"approvalType": {"const": "VISUAL_BASELINE"}, "authority": {"const": "INDEPENDENT_REVIEWER"}, "reviewDiscipline": {"const": "VISUAL_CONSISTENCY"}}, "required": ["approvalType", "authority", "reviewDiscipline"]}},
              {"contains": {"properties": {"approvalType": {"const": "VISUAL_BASELINE"}, "authority": {"const": "INDEPENDENT_REVIEWER"}, "reviewDiscipline": {"const": "UNITY_FEASIBILITY"}}, "required": ["approvalType", "authority", "reviewDiscipline"]}},
              {"contains": {"properties": {"approvalType": {"const": "VISUAL_BASELINE"}, "authority": {"const": "INDEPENDENT_REVIEWER"}, "reviewDiscipline": {"const": "UX_READABILITY"}}, "required": ["approvalType", "authority", "reviewDiscipline"]}}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
  }
}
