{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/unity-workflow/schemas/layout-measurement.schema.json",
  "title": "Unity 实际 UI 布局测量请求",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "scenePath", "uiSystem", "coordinateSpace", "outputPath", "targets"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "taskId": {"$ref": "common.schema.json#/$defs/taskId"},
    "candidateId": {"$ref": "common.schema.json#/$defs/taskId"},
    "scenePath": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/projectRelativePath"},
        {"pattern": "\\.[Uu][Nn][Ii][Tt][Yy]$"}
      ]
    },
    "uiSystem": {"enum": ["UGUI", "UI_TOOLKIT"]},
    "coordinateSpace": {"enum": ["SCREEN_SPACE_PIXELS", "UI_TOOLKIT_LOGICAL_POINTS"]},
    "outputPath": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/projectRelativePath"},
        {"pattern": "\\.json$"}
      ]
    },
    "gapAxis": {"enum": ["horizontal", "vertical"]},
    "includeComponentSnapshots": {"type": "boolean"},
    "stateId": {"type": "string", "minLength": 1},
    "evidenceRoot": {"$ref": "common.schema.json#/$defs/projectRelativePath"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/target"}
    }
  },
  "$defs": {
    "gapValue": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {"value": {"type": "number"}}
        },
        {"type": "null"}
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parentPath", "fromId", "toId", "actualGap", "targetGap", "deltaGap"],
      "properties": {
        "parentPath": {"type": "string", "minLength": 1},
        "fromId": {"$ref": "common.schema.json#/$defs/taskId"},
        "toId": {"$ref": "common.schema.json#/$defs/taskId"},
        "actualGap": {"type": "number", "description": "负值表示所选相邻节点在该轴上重叠。"},
        "targetGap": {"$ref": "#/$defs/gapValue"},
        "deltaGap": {"$ref": "#/$defs/gapValue"}
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/taskId"},
        "objectPath": {"type": "string", "minLength": 1},
        "parentObjectPath": {"type": "string", "minLength": 1},
        "documentPath": {"type": "string", "minLength": 1},
        "elementName": {"type": "string", "minLength": 1},
        "parentElementName": {"type": "string", "minLength": 1},
        "referenceId": {"type": "string", "minLength": 1},
        "referenceObjectPath": {"type": "string", "minLength": 1},
        "referenceElementName": {"type": "string", "minLength": 1},
        "referenceRoot": {"enum": ["viewport", "safe-area"]},
        "targetRect": {"$ref": "#/$defs/rect"},
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAbsDelta"],
          "properties": {"maxAbsDelta": {"type": "number", "minimum": 0}}
        }
      },
      "allOf": [
        {"not": {"anyOf": [
          {"required": ["referenceObjectPath", "referenceElementName"]},
          {"required": ["referenceObjectPath", "referenceRoot"]},
          {"required": ["referenceElementName", "referenceRoot"]}
        ]}},
        {
          "if": {"properties": {"objectPath": {"minLength": 1}}, "required": ["objectPath"]},
          "then": {
            "required": ["parentObjectPath"],
            "not": {"anyOf": [{"required": ["documentPath"]}, {"required": ["elementName"]}, {"required": ["parentElementName"]}]}
          },
          "else": {
            "required": ["documentPath", "elementName", "parentElementName"],
            "not": {"required": ["parentObjectPath"]}
          }
        },
        {
          "if": {"required": ["tolerance"]},
          "then": {"required": ["targetRect"]}
        }
      ],
      "description": "目标矩形和容差只能声明期望值；实际矩形必须由 Unity Editor 从场景对象读取。"
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objectPath", "elementName", "parentPath", "actualRect", "parentRect", "margins", "targetRect", "delta", "tolerance", "status"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/taskId"},
        "objectPath": {"type": "string"},
        "elementName": {"type": "string"},
        "parentPath": {"type": "string", "minLength": 1},
        "actualRect": {"anyOf": [{"$ref": "#/$defs/rect"}, {"type": "null"}]},
        "parentRect": {"anyOf": [{"$ref": "#/$defs/rect"}, {"type": "null"}]},
        "referenceId": {"type": "string"},
        "referencePath": {"type": "string"},
        "referenceRect": {"anyOf": [{"$ref": "#/$defs/rect"}, {"type": "null"}]},
        "componentSnapshot": {"anyOf": [{"$ref": "#/$defs/componentSnapshot"}, {"type": "null"}]},
        "margins": {"anyOf": [{"type": "null"}, {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "top", "right", "bottom"],
          "properties": {
            "left": {"type": "number"},
            "top": {"type": "number"},
            "right": {"type": "number"},
            "bottom": {"type": "number"}
          }
        }]},
        "targetRect": {"anyOf": [{"$ref": "#/$defs/rect"}, {"type": "null"}]},
        "delta": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": {"type": "number"},
                "y": {"type": "number"},
                "width": {"type": "number"},
                "height": {"type": "number"}
              }
            },
            {"type": "null"}
          ]
        },
        "tolerance": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["maxAbsDelta"],
              "properties": {"maxAbsDelta": {"type": "number", "minimum": 0}}
            },
            {"type": "null"}
          ]
        },
        "status": {"enum": ["MEASURED", "PASS", "FAIL", "INACTIVE"]}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "INACTIVE"}}, "required": ["status"]},
        "then": {"required": ["componentSnapshot"], "properties": {"margins": {"type": "null"}, "componentSnapshot": {"type": "object", "properties": {"active": {"const": false}}}}},
        "else": {"properties": {"actualRect": {"$ref": "#/$defs/rect"}, "parentRect": {"$ref": "#/$defs/rect"}, "margins": {"type": "object"}}}
      }]
    },
    "snapshotSize": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": {"width": {"type": "number", "minimum": 0}, "height": {"type": "number", "minimum": 0}}
    },
    "rectTransformSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["anchorMin", "anchorMax", "pivot", "sizeDelta", "anchoredPosition", "localSize", "drivenBy"],
      "properties": {
        "anchorMin": {"$ref": "common.schema.json#/$defs/vector2"}, "anchorMax": {"$ref": "common.schema.json#/$defs/vector2"},
        "pivot": {"$ref": "common.schema.json#/$defs/vector2"}, "sizeDelta": {"$ref": "common.schema.json#/$defs/vector2"},
        "anchoredPosition": {"$ref": "common.schema.json#/$defs/vector2"}, "localSize": {"$ref": "#/$defs/snapshotSize"}, "drivenBy": {"type": "string"}
      }
    },
    "layoutGroupSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "enabled", "childControlWidth", "childControlHeight", "childForceExpandWidth", "childForceExpandHeight", "cellSize"],
      "properties": {
        "type": {"type": "string"}, "enabled": {"type": "boolean"},
        "childControlWidth": {"type": "boolean"}, "childControlHeight": {"type": "boolean"},
        "childForceExpandWidth": {"type": "boolean"}, "childForceExpandHeight": {"type": "boolean"},
        "cellSize": {"anyOf": [{"$ref": "#/$defs/snapshotSize"}, {"type": "null"}]}
      }
    },
    "contentSizeFitterSnapshot": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "horizontalFit", "verticalFit"],
      "properties": {"enabled": {"type": "boolean"}, "horizontalFit": {"enum": ["Unconstrained", "MinSize", "PreferredSize"]}, "verticalFit": {"enum": ["Unconstrained", "MinSize", "PreferredSize"]}}
    },
    "aspectRatioFitterSnapshot": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "aspectMode", "aspectRatio"],
      "properties": {"enabled": {"type": "boolean"}, "aspectMode": {"enum": ["None", "WidthControlsHeight", "HeightControlsWidth", "FitInParent", "EnvelopeParent"]}, "aspectRatio": {"type": "number"}}
    },
    "imageSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["assetGuid", "localId", "assetPath", "sourceSize", "pixelsPerUnit", "imagePixelsPerUnit", "referencePixelsPerUnit", "pixelsPerUnitMultiplier", "type", "localSize", "nativeSize", "hasBorder", "preserveAspect", "border"],
      "properties": {
        "assetGuid": {"type": "string"}, "localId": {"type": "string"}, "assetPath": {"type": "string"},
        "sourceSize": {"$ref": "#/$defs/snapshotSize"}, "localSize": {"$ref": "#/$defs/snapshotSize"}, "nativeSize": {"$ref": "#/$defs/snapshotSize"},
        "pixelsPerUnit": {"type": "number"}, "imagePixelsPerUnit": {"type": "number"},
        "referencePixelsPerUnit": {"type": "number"}, "pixelsPerUnitMultiplier": {"type": "number"},
        "type": {"enum": ["Simple", "Sliced", "Tiled", "Filled"]}, "hasBorder": {"type": "boolean"}, "preserveAspect": {"type": "boolean"},
        "border": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0}}
      }
    },
    "uiToolkitSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "display", "width", "height", "flexGrow", "flexShrink", "flexDirection", "alignItems", "justifyContent", "backgroundAssetGuid", "sliceLeft", "sliceRight", "sliceTop", "sliceBottom", "sliceScale"],
      "properties": {
        "position": {"enum": ["Relative", "Absolute"]}, "display": {"enum": ["Flex", "None"]}, "width": {"type": "number"}, "height": {"type": "number"},
        "flexGrow": {"type": "number"}, "flexShrink": {"type": "number"}, "flexDirection": {"type": "string"},
        "alignItems": {"type": "string"}, "justifyContent": {"type": "string"}, "backgroundAssetGuid": {"type": "string"},
        "sliceLeft": {"type": "number"}, "sliceRight": {"type": "number"}, "sliceTop": {"type": "number"}, "sliceBottom": {"type": "number"}, "sliceScale": {"type": "number"}
      }
    },
    "externalWriterSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["driver", "ownerType", "ownerPath", "active", "elementName", "position", "width", "height"],
      "properties": {
        "driver": {"enum": ["SCRIPT", "ANIMATION"]}, "ownerType": {"type": "string"}, "ownerPath": {"type": "string"},
        "active": {"type": "boolean"}, "elementName": {"type": "string"}, "position": {"type": "boolean"}, "width": {"type": "boolean"}, "height": {"type": "boolean"}
      }
    },
    "componentSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["active", "positionWriters", "widthWriters", "heightWriters", "observationScope", "rectTransform", "layoutGroup", "parentLayoutGroup", "contentSizeFitter", "aspectRatioFitter", "image", "uiToolkit", "externalWriters"],
      "properties": {
        "active": {"type": "boolean"}, "observationScope": {"const": "ENGINE_COMPONENTS_AND_REGISTERED_WRITERS"},
        "positionWriters": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/layoutDriver"}},
        "widthWriters": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/layoutDriver"}},
        "heightWriters": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/layoutDriver"}},
        "rectTransform": {"anyOf": [{"$ref": "#/$defs/rectTransformSnapshot"}, {"type": "null"}]},
        "layoutGroup": {"anyOf": [{"$ref": "#/$defs/layoutGroupSnapshot"}, {"type": "null"}]},
        "parentLayoutGroup": {"anyOf": [{"$ref": "#/$defs/layoutGroupSnapshot"}, {"type": "null"}]},
        "contentSizeFitter": {"anyOf": [{"$ref": "#/$defs/contentSizeFitterSnapshot"}, {"type": "null"}]},
        "aspectRatioFitter": {"anyOf": [{"$ref": "#/$defs/aspectRatioFitterSnapshot"}, {"type": "null"}]},
        "image": {"anyOf": [{"$ref": "#/$defs/imageSnapshot"}, {"type": "null"}]},
        "uiToolkit": {"anyOf": [{"$ref": "#/$defs/uiToolkitSnapshot"}, {"type": "null"}]},
        "externalWriters": {"type": "array", "items": {"$ref": "#/$defs/externalWriterSnapshot"}}
      },
      "allOf": [{"if": {"properties": {"active": {"const": false}}, "required": ["active"]}, "then": {"properties": {"positionWriters": {"maxItems": 0}, "widthWriters": {"maxItems": 0}, "heightWriters": {"maxItems": 0}}}}]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "status", "taskId", "scenePath", "uiSystem", "coordinateSpace", "unit", "origin", "generatedAtUtc", "outputPath", "measurements", "gapAxis", "gapNote", "gaps"],
      "properties": {
        "schemaVersion": {"const": "1.0"},
        "status": {"enum": ["MEASURED", "PASS", "FAIL", "BLOCKED"]},
        "errorCode": {"type": "string"},
        "message": {"type": "string"},
        "taskId": {"$ref": "common.schema.json#/$defs/taskId"},
        "candidateId": {"anyOf": [{"$ref": "common.schema.json#/$defs/taskId"}, {"const": ""}]},
        "measurementSource": {"type": "string"},
        "runId": {"type": "string"},
        "frameCount": {"type": "integer", "minimum": 0},
        "stateId": {"type": "string"},
        "includesComponentSnapshots": {"type": "boolean"},
        "viewportRect": {"anyOf": [{"$ref": "#/$defs/rect"}, {"type": "null"}]},
        "safeAreaRect": {"anyOf": [{"$ref": "#/$defs/rect"}, {"type": "null"}]},
        "scenePath": {"$ref": "common.schema.json#/$defs/projectRelativePath"},
        "uiSystem": {"enum": ["UGUI", "UI_TOOLKIT"]},
        "coordinateSpace": {"enum": ["SCREEN_SPACE_PIXELS", "UI_TOOLKIT_LOGICAL_POINTS"]},
        "unit": {"enum": ["PIXEL", "POINT"]},
        "origin": {"enum": ["SCREEN_TOP_LEFT", "UIDOCUMENT_ROOT_TOP_LEFT"]},
        "generatedAtUtc": {"type": "string", "format": "date-time", "pattern": "(?:[Zz]|[+]00:00)$"},
        "outputPath": {"$ref": "common.schema.json#/$defs/projectRelativePath"},
        "measurements": {"type": "array", "items": {"$ref": "#/$defs/measurement"}},
        "gapAxis": {"enum": ["", "horizontal", "vertical"]},
        "gapNote": {"type": "string"},
        "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
      },
      "allOf": [
        {
          "if": {"properties": {"includesComponentSnapshots": {"const": true}}, "required": ["includesComponentSnapshots"]},
          "then": {
            "required": ["measurementSource", "runId", "frameCount", "stateId", "viewportRect", "safeAreaRect"],
            "properties": {
              "measurementSource": {"const": "UNITY_EDITOR_LOADED_SCENE"}, "runId": {"minLength": 1}, "stateId": {"minLength": 1},
              "viewportRect": {"$ref": "#/$defs/rect"}, "safeAreaRect": {"$ref": "#/$defs/rect"},
              "measurements": {"items": {"required": ["referenceId", "referencePath", "referenceRect", "componentSnapshot"], "properties": {"componentSnapshot": {"$ref": "#/$defs/componentSnapshot"}}}}
            }
          }
        },
        {
          "if": {"properties": {"gapAxis": {"const": ""}}, "required": ["gapAxis"]},
          "then": {"properties": {"gaps": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"uiSystem": {"const": "UGUI"}}, "required": ["uiSystem"]},
          "then": {
            "properties": {
              "coordinateSpace": {"const": "SCREEN_SPACE_PIXELS"},
              "origin": {"const": "SCREEN_TOP_LEFT"}
            }
          },
          "else": {
            "properties": {
              "coordinateSpace": {"const": "UI_TOOLKIT_LOGICAL_POINTS"},
              "origin": {"const": "UIDOCUMENT_ROOT_TOP_LEFT"}
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"includeComponentSnapshots": {"const": true}}, "required": ["includeComponentSnapshots"]},
      "then": {
        "required": ["stateId", "evidenceRoot"],
        "properties": {"targets": {"items": {"required": ["referenceId"]}}}
      },
      "else": {"properties": {"outputPath": {"pattern": "^Artifacts/Visual/.+\\.json$"}}}
    },
    {
      "if": {"properties": {"uiSystem": {"const": "UGUI"}}, "required": ["uiSystem"]},
      "then": {
        "properties": {
          "coordinateSpace": {"const": "SCREEN_SPACE_PIXELS"},
          "targets": {
            "items": {
              "required": ["objectPath", "parentObjectPath"],
              "not": {"anyOf": [{"required": ["documentPath"]}, {"required": ["elementName"]}, {"required": ["parentElementName"]}, {"required": ["referenceElementName"]}]}
            }
          }
        }
      },
      "else": {
        "properties": {
          "coordinateSpace": {"const": "UI_TOOLKIT_LOGICAL_POINTS"},
          "targets": {
            "items": {
              "required": ["documentPath", "elementName", "parentElementName"],
              "not": {"anyOf": [{"required": ["objectPath"]}, {"required": ["parentObjectPath"]}, {"required": ["referenceObjectPath"]}]}
            }
          }
        }
      }
    }
  ],
  "description": "此契约不接受手填的实际 bounds 或组件快照；每个请求只允许一种 UI 系统和一种坐标空间。组件采集要求显式状态、证据根和参照ID，输出必须由Unity限制在该证据根内。gapAxis只描述所选同级节点实测间距。UI Toolkit使用同一UIDocument根左上逻辑点坐标。"
}
