{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/unity-workflow/schemas/quality-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "projectId", "sourceRevision", "buildVersion", "generatedAtUtc", "checks", "status", "evidence"],
          "properties": {
    "schemaVersion": {"const": "1.0"},
    "taskId": {"$ref": "common.schema.json#/$defs/taskId"},
    "projectId": {"$ref": "common.schema.json#/$defs/taskId"},
    "sourceRevision": {"type": "string", "minLength": 1},
    "buildVersion": {"type": "string", "minLength": 1},
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:[Zz]|[+]00:00)$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "status", "message", "evidence"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/taskId"},
          "category": {"enum": ["schema", "static", "compile", "console", "test", "gameplay", "visual", "accessibility", "asset", "audio", "performance", "build", "security", "compliance"]},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
          "message": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "environment": {"type": "string", "minLength": 1},
          "startedAtUtc": {"type": "string", "format": "date-time"},
          "finishedAtUtc": {"type": "string", "format": "date-time"},
          "failureReason": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidence"}}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
              "then": {"properties": {"evidence": {"minItems": 1}}}
            },
            {
              "if": {"properties": {"status": {"enum": ["FAIL", "BLOCKED"]}}, "required": ["status"]},
              "then": {"required": ["failureReason"]}
            }
          ]
      }
    },
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
    "evidence": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidence"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {
        "properties": {
          "evidence": {"minItems": 1},
          "checks": {
            "items": {
              "properties": {"status": {"const": "PASS"}},
              "required": ["status"]
            }
          }
        }
      }
    }
  ]
}
