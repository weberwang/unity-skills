{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/unity-workflow/schemas/common.schema.json",
  "title": "Unity 工作流公共定义",
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,95}$"
    },
    "productionRoute": {
      "enum": ["REUSE", "GENERATE", "REDRAW", "PROGRAMMATIC", "MODEL_3D", "MATERIAL", "VFX", "CODE", "BLOCKED"]
    },
    "projectRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "unityInstance": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s@]+(?:@[A-Za-z0-9._-]+)?$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalType", "authority", "subjectId", "subjectVersion",
        "approvedBy", "approvedAtUtc", "evidencePath", "evidenceSha256"
      ],
      "properties": {
        "approvalType": {
          "enum": [
            "VISUAL_BASELINE", "GAME_VISUAL", "UI_VISUAL", "IMPLEMENTATION_VISUAL", "RUNTIME_VISUAL",
            "PREFAB_STRUCTURE", "ASSET_MAP", "DECOMPOSITION", "GRILLING_DECISION", "QUALITY_GATE",
            "RELEASE", "RISK_WAIVER"
          ]
        },
        "authority": {"enum": ["USER", "INDEPENDENT_REVIEWER"]},
        "subjectId": {"$ref": "#/$defs/taskId"},
        "subjectVersion": {"type": "string", "minLength": 1},
        "approvedBy": {"type": "string", "minLength": 1},
        "approvedAtUtc": {"type": "string", "format": "date-time", "pattern": "(?:[Zz]|[+]00:00)$"},
        "evidencePath": {"$ref": "#/$defs/projectRelativePath"},
        "evidenceSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "approvalScope": {"$ref": "#/$defs/splitPlanApprovalScope"},
        "reviewTaskId": {"$ref": "#/$defs/taskId"},
        "reviewDiscipline": {
          "enum": ["VISUAL_CONSISTENCY", "UNITY_FEASIBILITY", "UX_READABILITY", "QA", "RELEASE"]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"authority": {"const": "INDEPENDENT_REVIEWER"}}, "required": ["authority"]},
          "then": {"required": ["reviewTaskId", "reviewDiscipline"]}
        }
      ]
    },
    "splitPlanApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalType", "authority", "subjectId", "subjectVersion",
        "approvedBy", "approvedAtUtc", "evidencePath", "evidenceSha256", "approvalScope"
      ],
      "properties": {
        "approvalType": {"const": "ASSET_MAP"},
        "authority": {"const": "USER"},
        "subjectId": {"$ref": "#/$defs/taskId"},
        "subjectVersion": {"type": "string", "minLength": 1},
        "approvedBy": {"type": "string", "minLength": 1},
        "approvedAtUtc": {"type": "string", "format": "date-time", "pattern": "(?:[Zz]|[+]00:00)$"},
        "evidencePath": {"$ref": "#/$defs/projectRelativePath"},
        "evidenceSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "approvalScope": {"$ref": "#/$defs/splitPlanApprovalScope"}
      }
    },
    "splitPlanAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elementIndex", "itemId", "coordinateSpace", "bounds", "label", "productionRoute", "brief"],
      "properties": {
        "elementIndex": {"type": "integer", "minimum": 1},
        "itemId": {"$ref": "#/$defs/taskId"},
        "coordinateSpace": {"const": "EFFECT_IMAGE_PIXELS"},
        "productionRoute": {"$ref": "#/$defs/productionRoute"},
        "bounds": {
          "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0},
            "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}
          }
        },
        "label": {"type": "string", "minLength": 1},
        "brief": {"type": "string", "minLength": 1}
      }
    },
    "splitPlanApprovalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotatedPreview", "sourceHighFidelity", "items", "excludedElements"],
      "properties": {
        "annotatedPreview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "sha256", "sourcePath", "sourceSha256", "sourceVersion", "width", "height", "annotations"],
          "properties": {
            "type": {"const": "annotated-split-preview"},
            "path": {"$ref": "#/$defs/projectRelativePath"},
            "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
            "sourcePath": {"$ref": "#/$defs/projectRelativePath"},
            "sourceSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
            "sourceVersion": {"type": "string", "minLength": 1},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1},
            "annotations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/splitPlanAnnotation"}}
          }
        },
        "sourceHighFidelity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subjectId", "subjectVersion", "path", "sha256"],
          "properties": {
            "subjectId": {"$ref": "#/$defs/taskId"},
            "subjectVersion": {"type": "string", "minLength": 1},
            "path": {"$ref": "#/$defs/projectRelativePath"},
            "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "resourceId", "itemVersion", "itemSpecSha256", "elementIndex", "assetType", "purpose",
              "generationBrief", "bounds", "stateVariants", "targetPrefabNodeIds", "targetPath", "delivery", "action", "splitRationale"
            ],
            "properties": {
              "id": {"$ref": "#/$defs/taskId"},
              "resourceId": {"$ref": "#/$defs/taskId"},
              "itemVersion": {"type": "string", "minLength": 1},
              "itemSpecSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
              "elementIndex": {"type": "integer", "minimum": 1},
              "assetType": {"type": "string", "minLength": 1},
              "purpose": {"type": "string", "minLength": 1},
              "generationBrief": {"type": "string", "minLength": 1},
              "bounds": {
                "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
                "properties": {
                  "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0},
                  "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}
                }
              },
              "targetSize": {
                "type": "object", "additionalProperties": false, "required": ["width", "height"],
                "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
              },
              "alphaRequired": {"type": "boolean"},
              "pivot": {
                "type": "object", "additionalProperties": false, "required": ["x", "y"],
                "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}}
              },
              "pixelsPerUnit": {"type": "number", "exclusiveMinimum": 0},
              "border": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
              "stateVariants": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["id", "description"],
                  "properties": {"id": {"$ref": "#/$defs/taskId"}, "description": {"type": "string", "minLength": 1}}
                }
              },
              "targetPrefabNodeIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/taskId"}},
              "targetPath": {"$ref": "#/$defs/projectRelativePath"},
              "delivery": {"enum": ["SINGLE_SPRITE", "SPRITE_SHEET", "ATLAS", "UI_TEXTURE", "NOT_APPLICABLE"]},
              "action": {"$ref": "#/$defs/productionRoute"},
              "existingAssetId": {"$ref": "#/$defs/taskId"},
              "reuseReason": {"type": "string", "minLength": 1},
              "reuseResourcePlan": {"$ref": "reuse-resource-plan.schema.json#/$defs/reuseResourcePlan"},
              "splitRationale": {"type": "string", "minLength": 1}
            },
            "allOf": [
              {
                "if": {"properties": {"action": {"const": "REUSE"}}, "required": ["action"]},
                "then": {"required": ["existingAssetId", "reuseReason", "reuseResourcePlan"]},
                "else": {"not": {"required": ["reuseResourcePlan"]}}
              },
              {
                "if": {"properties": {"delivery": {"const": "NOT_APPLICABLE"}}, "required": ["delivery"]},
                "then": {"not": {"anyOf": [{"required": ["targetSize"]}, {"required": ["alphaRequired"]}, {"required": ["pivot"]}, {"required": ["pixelsPerUnit"]}, {"required": ["border"]}]}},
                "else": {"required": ["targetSize", "alphaRequired", "pivot", "pixelsPerUnit", "border"]}
              },
              {
                "if": {"properties": {"action": {"enum": ["MODEL_3D", "MATERIAL", "VFX", "CODE", "PROGRAMMATIC"]}}, "required": ["action"]},
                "then": {"properties": {"delivery": {"const": "NOT_APPLICABLE"}}}
              },
              {
                "if": {"properties": {"action": {"enum": ["GENERATE", "REDRAW", "REUSE"]}}, "required": ["action"]},
                "then": {"properties": {"delivery": {"enum": ["SINGLE_SPRITE", "SPRITE_SHEET", "ATLAS", "UI_TEXTURE"]}}}
              }
            ]
          }
        },
        "excludedElements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "reason"],
            "properties": {"description": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "sha256"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/projectRelativePath"},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "projectId": {"$ref": "#/$defs/taskId"},
        "subjectId": {"$ref": "#/$defs/taskId"},
        "subjectVersion": {"type": "string", "minLength": 1},
        "sourceRevision": {"type": "string", "minLength": 1},
        "projectStateVersion": {"type": "string", "minLength": 1},
        "buildVersion": {"type": "string", "minLength": 1},
        "artifactType": {"enum": ["WINDOWS_EXECUTABLE", "ANDROID_APK", "ANDROID_APP_BUNDLE", "IOS_IPA"]},
        "platform": {"enum": ["WINDOWS", "ANDROID", "IOS", "IPADOS"]}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "platform-build-artifact"}}, "required": ["type"]},
          "then": {
            "required": [
              "artifactType", "platform", "projectId", "subjectId", "subjectVersion",
              "sourceRevision", "projectStateVersion", "buildVersion"
            ]
          }
        },
        {
          "if": {"properties": {"type": {"const": "platform-adaptation-test-report"}}, "required": ["type"]},
          "then": {
            "required": [
              "platform", "projectId", "subjectId", "subjectVersion",
              "sourceRevision", "projectStateVersion", "buildVersion"
            ]
          }
        },
        {
          "if": {"properties": {"artifactType": {"const": "WINDOWS_EXECUTABLE"}}, "required": ["artifactType"]},
          "then": {"properties": {"platform": {"const": "WINDOWS"}, "path": {"pattern": "\\.[Ee][Xx][Ee]$"}}}
        },
        {
          "if": {"properties": {"artifactType": {"const": "ANDROID_APK"}}, "required": ["artifactType"]},
          "then": {"properties": {"platform": {"const": "ANDROID"}, "path": {"pattern": "\\.[Aa][Pp][Kk]$"}}}
        },
        {
          "if": {"properties": {"artifactType": {"const": "ANDROID_APP_BUNDLE"}}, "required": ["artifactType"]},
          "then": {"properties": {"platform": {"const": "ANDROID"}, "path": {"pattern": "\\.[Aa][Aa][Bb]$"}}}
        },
        {
          "if": {"properties": {"artifactType": {"const": "IOS_IPA"}}, "required": ["artifactType"]},
          "then": {"properties": {"platform": {"enum": ["IOS", "IPADOS"]}, "path": {"pattern": "\\.[Ii][Pp][Aa]$"}}}
        }
      ]
    },
    "grillingEvidence": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "required": ["projectId", "subjectId", "subjectVersion", "sourceRevision", "projectStateVersion"],
          "properties": {"type": {"const": "grilling-record"}}
        }
      ]
    },
    "candidateSnapshot": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "required": ["projectId", "subjectId", "subjectVersion", "sourceRevision", "projectStateVersion"],
          "properties": {"type": {"const": "grilling-subject-snapshot"}}
        }
      ]
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/taskId"},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "failureReason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
          "then": {"properties": {"evidence": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["FAIL", "BLOCKED"]}}, "required": ["status"]},
          "then": {"required": ["failureReason"]}
        }
      ]
    }
  }
}
