{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/unity-workflow/schemas/delivery-preflight.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "projectId", "sourceRevision", "platform", "version", "outputDirectory", "artifactName", "qualityReportPaths", "visualApprovalPaths"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "taskId": {"$ref": "common.schema.json#/$defs/taskId"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "sourceRevision": {"type": "string", "minLength": 7},
    "platform": {"const": "Windows"},
    "version": {"type": "string", "minLength": 1},
    "outputDirectory": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/projectRelativePath"},
        {"pattern": "^Artifacts/"}
      ]
    },
    "artifactName": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "qualityReportPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/projectRelativePath"}
    },
    "visualApprovalPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/projectRelativePath"}
    }
  }
}
