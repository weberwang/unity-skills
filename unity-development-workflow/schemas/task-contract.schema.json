{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/unity-workflow/schemas/task-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "module", "dependsOn", "scope", "locks", "execution", "acceptance", "outputs"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"$ref": "common.schema.json#/$defs/taskId"},
    "module": {"type": "string", "minLength": 1},
    "dependsOn": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/taskId"}},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write"],
      "properties": {
        "read": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/projectRelativePath"}},
        "write": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/projectRelativePath"}}
      }
    },
    "locks": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/lockRequest"}},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentRole", "executionLevel", "isolation"],
      "properties": {
        "agentRole": {"type": "string", "minLength": 1},
        "executionLevel": {"enum": ["L0", "L1", "L2"]},
        "isolation": {"enum": ["none", "path-ownership", "git-worktree"]},
        "unityInstance": {"$ref": "common.schema.json#/$defs/unityInstance"}
      },
      "allOf": [
        {
          "if": {"properties": {"executionLevel": {"const": "L2"}}, "required": ["executionLevel"]},
          "then": {"required": ["unityInstance"]},
          "else": {"not": {"required": ["unityInstance"]}}
        }
      ]
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "required"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    },
    "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/projectRelativePath"}}
  }
}
